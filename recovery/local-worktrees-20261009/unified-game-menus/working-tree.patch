+  assert.equal(page.$('race-start').disabled, true);
+  page.frames(3);
+  assert.equal(page.$('race-start').disabled, true);
+  assert.equal(page.doc.activeElement, page.$('boot-return'));
+  assert.match(page.$('boot-status').textContent, /Ready handoff failed/);
