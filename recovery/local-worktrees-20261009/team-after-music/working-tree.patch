+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Team relay anchors · Field Kit production candidate</title>
+    <link rel="stylesheet" href="../../../game/ui/field-kit-fonts.css" />
+    <link rel="stylesheet" href="../../../game/ui/field-kit-tokens.css" />
+    <style>
+      body {
