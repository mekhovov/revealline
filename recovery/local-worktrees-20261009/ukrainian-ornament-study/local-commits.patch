+const keeper = (id, x, y, heading) => ({
+  id,
+  role: 'field-keeper',
+  tier: 'measured',
+  x,
+  y,
+  heading,
+});
+const frontier = (id, x, y, side, clockwise = true) => ({
+  id,
+  role: 'frontier-patrol',
+  tier: 'measured',
+  edge: { x, y, side },
+  clockwise,
+});
+const outer = () => ({
+  id: 'outer',
+  role: 'perimeter-patrol',
+  tier: 'measured',
+  x: 71.5,
+  y: 25.5,
