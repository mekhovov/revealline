                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 50
            }
          },
          "required": [
            "width",
            "height",
            "safeBorder",
            "blockedRects"
          ],
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "properties": {
            "recipeId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "recipeVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "maxLength": 30
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
