{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xonix-authoring:content-pack:0.1.0",
  "title": "Xonix content authoring pack v0.1.0 (design contract; runtime not implemented)",
  "description": "Local data-only content. Primitive parameters are validated against the separate checked-in catalog.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 30
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "requiresCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "maxLength": 96
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 1,
      "maxItems": 500
    },
    "revealArt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revealArt"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "rulesets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleset"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/level"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "campaigns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/campaign"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "status",
    "title",
    "summary",
    "requiresCapabilities",
    "theme",
    "assets",
    "revealArt",
    "rulesets",
    "levels",
    "campaigns"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "kind": {
          "enum": [
            "image",
            "spritesheet",
            "audio",
            "font",
            "data"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "ready"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "spriteLayout": {
          "type": "object",
          "properties": {
            "frameWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "frameHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "frameCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "required": [
            "frameWidth",
            "frameHeight",
            "frameCount"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "original-human",
                "original-ai",
                "licensed",
                "public-domain",
                "user-supplied",
                "planned"
              ]
            },
            "creator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sourceUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "licenseEvidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "promptRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "reviewNotes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "method",
            "creator"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "brief",
        "provenance"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "family": {
          "enum": [
            "fpv-front",
            "ukraine-atlas",
            "retro-1994",
            "navi-network",
            "custom"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "artDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cultureNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "referenceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 30
        },
        "palette": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "safe": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "trail": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "player": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "enemy": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "objective": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "panel": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "field",
            "safe",
            "trail",
            "player",
            "enemy",
            "objective",
            "text",
            "panel"
          ],
          "additionalProperties": false
        },
        "vocabulary": {
          "type": "object",
          "properties": {
            "player": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "enemy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "capture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "score": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "player",
            "enemy",
            "capture",
            "score",
            "objective"
          ],
          "additionalProperties": false
        },
        "visualRoles": {
          "type": "object",
          "properties": {
            "player": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "fieldEnemy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "boundaryEnemy": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "objective": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "menuBackdrop": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            }
          },
          "required": [
            "player",
            "fieldEnemy",
            "boundaryEnemy",
            "objective",
            "menuBackdrop"
          ],
          "additionalProperties": false
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "maxLength": 96
              },
              "assetId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "maxLength": 96
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                },
                "minItems": 1,
                "maxItems": 120
              },
              "fps": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              },
              "loop": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "assetId",
              "frames",
              "fps",
              "loop"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "audio": {
          "type": "object",
          "properties": {
            "musicAssetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "cutAssetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "captureAssetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "failureAssetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            }
          },
          "required": [
            "musicAssetId",
            "cutAssetId",
            "captureAssetId",
            "failureAssetId"
          ],
          "additionalProperties": false
        },
        "presentation": {
          "type": "object",
          "properties": {
            "coverStyle": {
              "enum": [
                "flat",
                "dither",
                "fog",
                "blueprint"
              ]
            },
            "spriteSampling": {
              "const": "nearest"
            },
            "motionIntensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "crtStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "arenaAspect": {
              "const": "4:3"
            },
            "layoutPolicy": {
              "const": "fixed-arena-adaptive-chrome"
            }
          },
          "required": [
            "coverStyle",
            "spriteSampling",
            "motionIntensity",
            "crtStrength",
            "arenaAspect",
            "layoutPolicy"
          ],
          "additionalProperties": false
        },
        "imagePolicy": {
          "type": "object",
          "properties": {
            "allowedStyles": {
              "type": "array",
              "items": {
                "enum": [
                  "pixel-art",
                  "illustration",
                  "photograph",
                  "scanned-art"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            },
            "preserveOriginal": {
              "const": true
            },
            "cropApprovalRequired": {
              "const": true
            }
          },
          "required": [
            "allowedStyles",
            "preserveOriginal",
            "cropApprovalRequired"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "family",
        "title",
        "artDirection",
        "cultureNotes",
        "referenceUrls",
        "palette",
        "vocabulary",
        "visualRoles",
        "animations",
        "audio",
        "presentation",
        "imagePolicy"
      ],
      "additionalProperties": false
    },
    "revealArt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "sourceAssetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "style": {
          "enum": [
            "pixel-art",
            "illustration",
            "photograph",
            "scanned-art"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "altText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "crop"
          ]
        },
        "focalPoint": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "crop": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "sampling": {
          "enum": [
            "nearest",
            "linear"
          ]
        },
        "preserveSource": {
          "const": true
        },
        "cropApproved": {
          "type": "boolean"
        },
        "protectedRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0.0001,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0.0001,
                "maximum": 1
              }
            },
            "required": [
              "label",
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 50
        },
        "luminanceTreatment": {
          "enum": [
            "original",
            "dim-until-complete",
            "desaturate-until-complete"
          ]
        }
      },
      "required": [
        "id",
        "sourceAssetId",
        "style",
        "title",
        "caption",
        "altText",
        "fit",
        "focalPoint",
        "sampling",
        "preserveSource",
        "cropApproved",
        "protectedRegions",
        "luminanceTreatment"
      ],
      "additionalProperties": false
    },
    "ruleset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fillPolicy": {
          "type": "object",
          "properties": {
            "primitiveId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "maxLength": 96
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "primitiveId",
            "params"
          ],
          "additionalProperties": false
        },
        "lives": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "playerCellsPerSecond": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60
        },
        "scorePerCapturedCell": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "cutCommit": {
          "enum": [
            "hold",
            "toggle"
          ]
        },
        "trailContact": {
          "enum": [
            "lose-life",
            "cancel-cut"
          ]
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "maxLength": 96
              },
              "test": {
                "type": "object",
                "properties": {
                  "primitiveId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                    "maxLength": 96
                  },
                  "params": {
                    "type": "object"
                  }
                },
                "required": [
                  "primitiveId",
                  "params"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "test"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        },
        "completion": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "all",
                "any"
              ]
            },
            "goalIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                "maxLength": 96
              },
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "goalIds"
          ],
          "additionalProperties": false
        },
        "failure": {
          "type": "object",
          "properties": {
            "zeroLives": {
              "const": true
            },
            "timerExpiry": {
              "enum": [
                "fail",
                "ignore"
              ]
            }
          },
          "required": [
            "zeroLives",
            "timerExpiry"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "fillPolicy",
        "lives",
        "timeLimitSeconds",
        "playerCellsPerSecond",
        "scorePerCapturedCell",
        "cutCommit",
        "trailContact",
        "goals",
        "completion",
        "failure"
      ],
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rulesetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "revealArtId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "grid": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 8,
              "maximum": 256
            },
            "height": {
