      "family": "industrial",
      "referencePath": "authoring/library/challenge-chapter-art/originals/split-signal-foundry.png",
      "brief": "Keep tall brick foundry, lower workshop and signal mast. Reduce tiny rail/brick reflections and foreground quad detail; use a distinct narrow central opening.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-crosswind-depot",
