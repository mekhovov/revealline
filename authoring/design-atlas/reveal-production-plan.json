  "compositions": [
    {
      "id": "scene-orchard-window",
      "sourceGroup": 1,
      "subject": "Orchard gate at sunset",
      "family": "orchard",
      "referencePath": "authoring/library/fpv-arcade/backgrounds/orchard-window.png",
      "brief": "Keep the blue gate, blossom frame, distant village and open path. Dense floral microtexture, many highlight colors and the baked flying quad compete with the restrained new scene language.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-homeward-02",
      "sourceGroup": 2,
      "subject": "River railway at sunset",
      "family": "river",
      "referencePath": "authoring/library/homeward-skies/backgrounds/homeward-02.png",
      "brief": "Keep the railway crossing, river bend and station as this reward\u2019s identity. Reduce bloom, sparkling water and foreground sunflower texture; separately compose the 4:3 and 2:1 frames.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-frayed-causeway-fpv",
      "sourceGroup": 3,
      "subject": "Broken island causeway",
      "family": "river",
      "referencePath": "authoring/library/fracture-lines-art/originals/frayed-causeway-fpv.png",
      "brief": "Keep the broken crossing and three island structures. The large foreground quad, realistic rock texture and dense reflections dominate the small gameplay actors.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-open-the-circuit",
      "sourceGroup": 4,
      "subject": "Mountain radar station",
      "family": "relay",
      "referencePath": "authoring/library/sentinel-circuit-art/originals/open-the-circuit.png",
      "brief": "Keep the large off-center dish and mountain ridge. Simplify metallic detail, scattered lamps and sky glow; separate any narrative aircraft from active gameplay cues.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-night-signal",
      "sourceGroup": 5,
      "subject": "Night observatory",
      "family": "night",
      "referencePath": "authoring/library/fpv-arcade/backgrounds/night-signal.png",
      "brief": "Keep the observatory dome, quiet mountain horizon and aurora. Reduce bright stars and glow around the baked quad; reserve the clearest cyan/amber accents for gameplay.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-offset-docks-fpv",
      "sourceGroup": 6,
      "subject": "Offset lake docks",
      "family": "river",
      "referencePath": "authoring/library/countercurrent-art/originals/offset-docks-fpv.png",
      "brief": "Keep opposed docks and broad water space. Replace irregular wood and water microtexture with larger clusters; the left/right silhouette is a valuable distinctive composition.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-switchyard-gates",
      "sourceGroup": 7,
      "subject": "Industrial switchyard",
      "family": "industrial",
      "referencePath": "authoring/library/sentinel-circuit-art/originals/switchyard-gates.png",
      "brief": "Keep the rail gantries and converging gates. Simplify rail reflections and foreground equipment; avoid a prominent static quad that resembles the playable craft.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-homeward-01",
      "sourceGroup": 8,
      "subject": "Homeward village",
      "family": "village",
      "referencePath": "authoring/library/homeward-skies/backgrounds/homeward-01.png",
      "brief": "Keep the hillside cottages, apple tree and distant river. This is strong Ukrainian place imagery, but its dense illustrative highlights and broad palette need a new restrained pixel treatment.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-homeward-03",
      "sourceGroup": 9,
      "subject": "Night beacon hill",
      "family": "night",
      "referencePath": "authoring/library/homeward-skies/backgrounds/homeward-03.png",
      "brief": "Keep the beacon, winding river and distant town. This is a strong quiet composition; reduce moon bloom, glitter and detailed foreground embroidery for consistent pixel scale.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-courtyard-exits",
      "sourceGroup": 10,
      "subject": "Sunlit courtyard exits",
      "family": "courtyard",
      "referencePath": "authoring/library/fpv-pressure-art/originals/courtyard-exits.png",
      "brief": "Keep the mill arches and open exits. Replace tiny brick and flower texture, glowing reflections and the conspicuous flying quad with larger readable forms.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-night-crossfire",
      "sourceGroup": 11,
      "subject": "Night industrial waterway",
      "family": "night",
      "referencePath": "authoring/library/fpv-pressure-art/originals/night-crossfire.png",
      "brief": "Keep the blue lock basin, bridge and warm window rhythm. Reduce luminous microdetail and the flying quad so cable and threat silhouettes remain dominant.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-split-courtyard",
      "sourceGroup": 12,
      "subject": "Rainy split courtyard",
      "family": "courtyard",
      "referencePath": "authoring/library/fpv-arcade/backgrounds/split-courtyard.png",
      "brief": "Keep the paired gateways, split building masses and rainy mood. Dense wet reflections and a center quad need a calmer new treatment; do not lose the recognizable split silhouette.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-listening-court",
      "sourceGroup": 13,
      "subject": "Listening relay court",
      "family": "relay",
      "referencePath": "authoring/library/sentinel-circuit-art/originals/listening-court.png",
      "brief": "Keep the low walled court, relay masts and off-center service van. Replace finely shaded foliage, mud and hardware with deliberate clusters; distinguish this from the radar-dish scene.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-crossing-watch-fpv",
      "sourceGroup": 14,
      "subject": "Moonlit crossing watch",
      "family": "river",
      "referencePath": "authoring/library/countercurrent-art/originals/crossing-watch-fpv.png",
      "brief": "Keep the beacon on the left and workshop on the right framing water. Quiet center composition fits the hierarchy; realistic moonlight/reflection texture still needs the new pixel treatment.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-orchard-crossing",
      "sourceGroup": 15,
      "subject": "Orchard water crossing",
      "family": "orchard",
      "referencePath": "authoring/library/fpv-pressure-art/originals/orchard-crossing.png",
      "brief": "Keep diagonal orchard rows, the arch crossing and poplar silhouettes. Simplify leaves, masonry and mist; remove the prominent foreground quad from the gameplay reading area.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-split-ring-fpv",
      "sourceGroup": 16,
      "subject": "Circular silo yard",
      "family": "industrial",
      "referencePath": "authoring/library/fracture-lines-art/originals/split-ring-fpv.png",
      "brief": "Keep the round silo landmark and split track. Reduce realistic metal/mud texture and large foreground drone; retain the circular silhouette so it differs from other depot scenes.",
      "status": "planned; no new artwork produced"
    },
    {
      "id": "scene-fault-fan-fpv",
      "sourceGroup": 17,
      "subject": "Forked factory yard",
      "family": "industrial",
      "referencePath": "authoring/library/fracture-lines-art/originals/fault-fan-fpv.png",
      "brief": "Keep the fan of rails and two workshop masses. Simplify pipes, wet tracks and scattered lamps; this must remain a rail-fan composition rather than a recolored depot.",
      "status": "planned; no new artwork produced"
