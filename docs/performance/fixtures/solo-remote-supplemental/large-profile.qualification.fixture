{
  "format": "SoloQualificationV1",
  "id": "large-profile-public-import-and-reload",
  "kind": "lifecycle",
  "timeoutMs": 360000,
  "query": {
    "journey": "opening"
  },
  "coverage": [
    "480 saved campaign records",
    "3840 gallery records",
    "960 score records",
    "public import and reload",
    "metadata pressure only; original media and soundtrack libraries excluded"
  ],
  "actions": [
    {
      "type": "click",
      "selector": "#shell-featured",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused"
    },
    {
      "type": "click",
      "selector": "#shell-menu"
    },
    {
      "type": "click",
      "selector": "#shell-options"
    },
    {
      "type": "click",
      "selector": "#settings-tab-data"
    },
    {
      "type": "click",
      "selector": "#settings-saves"
    },
    {
      "type": "upload",
      "selector": "#save-file",
      "file": "large-profile.library.json"
    },
    {
      "type": "expect",
      "selector": "#undo-library:not(:disabled)",
      "timeoutMs": 60000
    },
    {
      "type": "expect",
      "selector": "#library-capacity",
      "contains": "480"
    },
    {
      "type": "snapshot",
      "group": "imported-large-profile"
    },
    {
      "type": "reload",
      "timeoutMs": 120000
    },
    {
      "type": "click",
      "selector": "#shell-continue",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused"
    },
    {
      "type": "click",
      "selector": "#shell-menu"
    },
    {
      "type": "click",
      "selector": "#shell-options"
    },
    {
      "type": "click",
      "selector": "#settings-tab-data"
    },
    {
      "type": "click",
      "selector": "#settings-saves"
    },
    {
      "type": "expect",
      "selector": "#library-capacity",
      "contains": "480"
    },
    {
      "type": "click",
      "selector": "[data-close=\"library-dialog\"]"
    },
    {
      "type": "click",
      "selector": "[data-close=\"settings-dialog\"]"
    },
    {
      "type": "key",
      "key": "Escape",
      "ms": 1
    },
    {
      "type": "click",
      "selector": "#start-button",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "repeat",
      "count": 30,
      "actions": [
        {
          "type": "key",
          "key": "ArrowRight",
          "ms": 250
        },
        {
          "type": "key",
          "key": "ArrowLeft",
          "ms": 250
        }
      ]
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused"
    },
    {
      "type": "snapshot",
      "group": "large-profile-playing"
    },
    {
      "type": "exportReplay"
    }
  ],
  "expectedReplayDefinition": {
    "level": {
