{
  "format": "SoloQualificationV1",
  "id": "selected-font-cancel-request-settlement-v4",
  "kind": "lifecycle",
  "timeoutMs": 240000,
  "query": {
    "journey": "opening"
  },
  "coverage": [
    "Passive identities and loaded-promise settlement of the exact existing selected-theme font demand; CSS source is bound, with no additional font request.",
    "Original public selection, Start, awaited Escape, verified response release and explicit Start actions are unchanged. Public FontFace status is retained separately from promise settlement.",
    "A separately named diagnostic only: old failed observations and all numerical, native replay and owner gates remain unchanged."
  ],
  "replayRequirements": {
    "movingTicks": 120
  },
  "actions": [
    {
      "type": "click",
      "selector": "#shell-options"
    },
    {
      "type": "click",
      "selector": "#settings-tab-display"
    },
    {
      "type": "click",
      "selector": "#theme-card-dnipro-porcelain",
      "label": "selected-theme"
    },
    {
      "type": "expect",
      "selector": "#theme-card-dnipro-porcelain",
      "attribute": "aria-pressed",
      "value": "true"
    },
    {
      "type": "click",
      "selector": "#settings-dialog .dialog-close[data-close=\"settings-dialog\"]"
    },
    {
      "type": "click",
      "selector": "#settings-dialog[open][data-settings-view=\"categories\"] button[data-close=\"settings-dialog\"]",
      "optional": true,
      "label": "close-settings-if-categories"
    },
    {
      "type": "expect",
      "selector": "body:not(:has(#settings-dialog[open])) #shell-home[open] #shell-featured:not(:disabled)",
      "timeoutMs": 5000,
      "label": "settings-actually-closed"
    },
    {
      "type": "click",
      "selector": "#shell-featured",
      "timeoutMs": 60000
    },
    {
      "type": "expect",
      "selector": "body:not([data-flight-state=\"running\"]):not(:has(dialog[open])) #flight-preparation-status[data-state=\"busy\"]",
      "timeoutMs": 5000,
      "label": "selected-font-blocks-start"
    },
    {
      "type": "key",
      "key": "Escape",
      "ms": 1,
      "label": "public-cancel-back"
    },
    {
      "type": "expect",
      "selector": "#flight-preparation-status[data-state=\"cancelled\"]",
      "timeoutMs": 5000,
      "label": "public-cancelled"
    },
    {
      "type": "expect",
      "selector": "html[data-interface-theme=\"dnipro-porcelain\"] body:not([data-flight-state=\"running\"])",
      "timeoutMs": 10000,
      "label": "original-theme-accepted-after-cancel"
    },
    {
      "type": "wait",
      "ms": 400,
      "label": "no-automatic-start-after-release"
    },
    {
      "type": "expect",
      "selector": "body:not([data-flight-state=\"running\"]):not(:has(dialog[open])) #start-button:not(:disabled)",
      "timeoutMs": 1000
    },
    {
      "type": "click",
      "selector": "#start-button"
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 15000
    },
    {
      "type": "key",
      "key": "ArrowLeft",
      "ms": 1200,
      "label": "safe-border-after-explicit-retry"
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused",
      "timeoutMs": 10000
    },
    {
      "type": "snapshot",
      "group": "after-selected-font-cancellation"
    },
    {
      "type": "exportReplay",
      "label": "after-selected-font-cancellation"
    }
  ],
  "expectedReplayDefinition": {
    "level": {
      "version": "xonix-level.v5",
