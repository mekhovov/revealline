  },
  "selectedFontCancellation": {
    "protocol": "selected-font-request-settlement-v4",
    "sourceRevision": "797e03f28743921842df6aa57520a72016ba3dfc",
    "targetRelativeToEntry": "ui/fonts/field-kit/handjet-display-600.woff2",
    "bytes": 38120,
    "sha256": "4797c11d5e17c3f5f9b5b3fa96efb4fd2aabb877fb4d625dfc8eb7465464e145",
    "fetchTimeoutMs": 10000,
    "maximumHoldMs": 60000,
    "claimBeforeNavigation": true,
    "waitForValidatedHeldAfterLabel": "selected-theme",
    "releaseAfterLabel": "public-cancelled",
    "responsePolicy": "unchanged original APIResponse; no redirects or retries",
    "sharedByDefaultAndSelectedThemes": true
  }
}
