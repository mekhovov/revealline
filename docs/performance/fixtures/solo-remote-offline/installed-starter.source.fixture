g way home","width":72,"height":36,"walls":[],"foundations":[{"x":10,"y":14,"w":4,"h":7},{"x":27,"y":12,"w":11,"h":3},{"x":34,"y":25,"w":11,"h":3},{"x":57,"y":14,"w":4,"h":7}],"terrain":[],"spawns":[{"id":"home","x":12.5,"y":17.5}]},{"format":"MapDesignV1","id":"nearby-shore-map","revision":"early-cultural-routes-1","name":"Nearby shore","width":72,"height":36,"walls":[],"foundations":[{"x":27,"y":12,"w":3,"h":3},{"x":39,"y":20,"w":4,"h":4}],"terrain":[],"spawns":[{"id":"home","x":32.5,"y":0.5}]},{"format":"MapDesignV1","id":"two-bays-map","revision":"early-cultural-routes-1","name":"Two bays","width":72,"height":36,"walls":[],"foundations":[{"x":33,"y":1,"w":3,"h":10},{"x":35,"y":10,"w":2,"h":15},{"x":33,"y":24,"w":3,"h":11}],"terrain":[],"spawns":[{"id":"home","x":35.5,"y":17.5}]}],"missions":[{"format":"MissionDesignV1","id":"first-return","revision":"pressure-v2-36e60a42b78b4f1b","name":"First return","map":{"id":"first-return-map","revision":"greybox-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"keeper","role":"field-keeper","tier":"measured","x":58.5,"y":23.5,"heading":[1,-1]}],"objectives":[],"bonuses":[],"coverage":0.3,"timeLimitSeconds":0,"design":{"routeDecision":"Cross to the far rail or turn back to the near rail?","lesson":"Reaching reclaimed ground secures a live line; empty regions fill.","counterplay":"Watch each keeper before departing; close early when its path threatens the line.","captureConsequence":"One keeper retains only the region it occupies at closure.","introduces":["enemy-seeded-closure"],"practices":[],"combines":[],"memorableMoment":"The first enclosure reveals a broad part of the horizon.","mastery":"Close a cut without losing a life.","durationSeconds":[10,45],"difficulty":{"band":1,"planning":1,"execution":1,"threatDensity":1,"timePressure":0,"mechanicLoad":1,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-first-return"}},{"format":"MissionDesignV1","id":"choose-your-share","revision":"pressure-v2-22994d37ea0a7a23","name":"Choose your share","map":{"id":"choose-your-share-map","revision":"greybox-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"keeper","role":"field-keeper","tier":"measured","x":17.5,"y":26.5,"heading":[-1,-1]}],"objectives":[],"bonuses":[],"coverage":0.65,"timeLimitSeconds":0,"design":{"routeDecision":"Take the nearby narrow slice now, or travel along the rail for a larger enclosure?","lesson":"A hit on an unfinished line sends visible impacts along it. Reach reclaimed ground before the craft-bound front arrives.","counterplay":"Watch each keeper before departing; close early when its path threatens the line.","captureConsequence":"The first captured area becomes the return surface for a shorter second cut.","introduces":["travelling-trail-impact"],"practices":["enemy-seeded-closure"],"combines":[],"memorableMoment":"A cautious first cut changes the best route for the next one.","mastery":"Complete the mission in three cuts or fewer.","durationSeconds":[30,90],"difficulty":{"band":1,"planning":1,"execution":1,"threatDensity":1,"timePressure":0,"mechanicLoad":1,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-choose-your-share"}},{"format":"MissionDesignV1","id":"two-keepers","revision":"pressure-v2-716a50f78f604234","name":"Two keepers","map":{"id":"two-keepers-map","revision":"greybox-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"west","role":"field-keeper","tier":"measured","x":15.5,"y":23.5,"heading":[-1,1]},{"id":"east","role":"field-keeper","tier":"measured","x":58.5,"y":12.5,"heading":[1,1]}],"objectives":[],"bonuses":[],"coverage":0.6,"timeLimitSeconds":0,"design":{"routeDecision":"Separate the two keepers first or wait until they share one side?","lesson":"Two occupied regions can keep their field even though the closing line is reclaimed.","counterplay":"Watch each keeper before departing; close early when its path threatens the line.","captureConsequence":"A line-only first cut establishes a permanent return lane for later enclosures.","introduces":[],"practices":["enemy-seeded-closure","travelling-trail-impact"],"combines":[],"memorableMoment":"The board explains why both occupied sides remain dark.","mastery":"Create and then use a line-only return lane.","durationSeconds":[45,110],"difficulty":{"band":1,"planning":1,"execution":1,"threatDensity":2,"timePressure":0,"mechanicLoad":1,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-two-keepers"}},{"format":"MissionDesignV1","id":"nearby-shore","revision":"early-cultural-routes-1","name":"Nearby shore","map":{"id":"nearby-shore-map","revision":"early-cultural-routes-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"west","role":"field-keeper","tier":"measured","x":17.5,"y":25.5,"heading":[-1,-1]},{"id":"east","role":"field-keeper","tier":"measured","x":60.5,"y":18.5,"heading":[1,1]}],"objectives":[],"bonuses":[],"coverage":0.6,"timeLimitSeconds":0,"design":{"routeDecision":"Take the short exposed line to the near woven landing, or cross the open gap to establish the larger far landing first?","lesson":"Separate foundation islands offer different return values; neither is earned coverage and neither fills territory by itself.","counterplay":"Commit to the near landing when the western keeper turns away. The far landing is more useful only when the eastern keeper leaves the open gap.","captureConsequence":"The near landing shortens the first return; the far landing creates a broader staging edge for the next enclosure.","introduces":["foundations"],"practices":["enemy-seeded-closure","travelling-trail-impact"],"combines":[],"memorableMoment":"Two Örnek-weaving-informed offset blocks turn the first island lesson into a real near-versus-far choice without borrowing a cultural symbol.","mastery":"Connect both landings before completing a large enclosure.","durationSeconds":[45,100],"difficulty":{"band":1,"planning":1,"execution":1,"threatDensity":2,"timePressure":0,"mechanicLoad":1,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-nearby-shore"}},{"format":"MissionDesignV1","id":"island-outpost","revision":"horizon-cultural-joins-1","name":"Island outpost","map":{"id":"island-outpost-map","revision":"horizon-cultural-joins-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"north","role":"field-keeper","tier":"measured","x":11.5,"y":8.5,"heading":[1,1]},{"id":"south","role":"field-keeper","tier":"measured","x":58.5,"y":25.5,"heading":[1,-1]}],"objectives":[],"bonuses":[],"coverage":0.62,"timeLimitSeconds":0,"design":{"routeDecision":"Close the short western join from the home panel, or make the longer bent return to the offset eastern stitches before choosing the next enclosure?","lesson":"A broad home panel and two broken joining points create different return distances without adding a rule beyond foundations and keeper reads.","counterplay":"Read the western keeper before the short closure. For the eastern join, leave from the upper edge and turn only after the keeper is moving away from the bent trail.","captureConsequence":"The west closure keeps a compact home return; the eastern stitch creates a smaller but more central departure for the following enclosure.","introduces":[],"practices":["foundations","enemy-seeded-closure","travelling-trail-impact"],"combines":[],"memorableMoment":"A Vyzhenka-informed broken joining rhythm turns one outpost into a short seam and an offset double return.","mastery":"Complete both the short western join and the bent eastern join without a loss.","durationSeconds":[45,110],"difficulty":{"band":1,"planning":1,"execution":1,"threatDensity":2,"timePressure":0,"mechanicLoad":1,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-island-outpost"}},{"format":"MissionDesignV1","id":"stepping-stones","revision":"cultural-spatial-triptych-1","name":"Stepping stones","map":{"id":"stepping-stones-map","revision":"cultural-spatial-triptych-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"west","role":"field-keeper","tier":"measured","x":21.5,"y":27.5,"heading":[1,-1]},{"id":"east","role":"field-keeper","tier":"measured","x":63.5,"y":24.5,"heading":[-1,-1]}],"objectives":[],"bonuses":[],"coverage":0.67,"timeLimitSeconds":0,"design":{"routeDecision":"Use the near seed landing to build a short spikelet chain, or bypass it for the broader central sun landing before choosing an upper or lower return?","lesson":"Five disconnected landings turn the early foundation lesson into a real route fork without adding a new rule.","counterplay":"Read both keepers from the boundary. The near landing limits exposure; the central landing gives more return directions but needs a longer opening cut.","captureConsequence":"Connecting one landing leaves the other branch intact, so the next enclosure begins from a materially different angle.","introduces":[],"practices":["foundations","travelling-trail-impact"],"combines":["foundations","enemy-seeded-closure"],"memorableMoment":"An original sun-and-spikelet spatial rhythm opens into visibly different upper and lower chains.","mastery":"Use both the near-spikelet and central-sun approaches without losing a life.","durationSeconds":[60,130],"difficulty":{"band":2,"planning":2,"execution":2,"threatDensity":2,"timePressure":0,"mechanicLoad":2,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-stepping-stones"}},{"format":"MissionDesignV1","id":"two-bays","revision":"early-cultural-routes-1","name":"Two bays","map":{"id":"two-bays-map","revision":"early-cultural-routes-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"west","role":"field-keeper","tier":"measured","x":13.5,"y":9.5,"heading":[1,1]},{"id":"east","role":"field-keeper","tier":"measured","x":58.5,"y":25.5,"heading":[-1,-1]}],"objectives":[],"bonuses":[],"coverage":0.68,"timeLimitSeconds":0,"design":{"routeDecision":"Work from the upper offset into the tighter western bay, or descend through the centre and use the lower offset against the wider eastern bay?","lesson":"A stepped divider still retains two occupied bays, but its unequal edges make departure height and capture order matter.","counterplay":"Use the upper shoulder for a short western cut; wait for the eastern keeper to retreat before crossing from the longer lower shoulder.","captureConsequence":"An upper closure improves the narrow bay without calming the east; a lower closure creates a longer return for the later eastern capture.","introduces":[],"practices":["foundations","enemy-seeded-closure","travelling-trail-impact"],"combines":["foundations","enemy-seeded-closure"],"memorableMoment":"A pysanka-layering-informed stepped axis replaces the uniform rail with alternating compartments and two enclosure rhythms.","mastery":"Earn territory from both offsets without using the outer boundary as the return.","durationSeconds":[60,130],"difficulty":{"band":2,"planning":2,"execution":2,"threatDensity":2,"timePressure":0,"mechanicLoad":2,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-two-bays"}},{"format":"MissionDesignV1","id":"courtyard-return","revision":"courtyard-spatial-1","name":"Courtyard return","map":{"id":"courtyard-return-map","revision":"courtyard-spatial-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"inside","role":"field-keeper","tier":"measured","x":37.5,"y":17.5,"heading":[1,1]},{"id":"outside","role":"field-keeper","tier":"measured","x":60.5,"y":26.5,"heading":[-1,-1]}],"objectives":[],"bonuses":[],"coverage":0.7,"timeLimitSeconds":0,"design":{"routeDecision":"Take the short outer bridge first, or move along the ring to choose an inward enclosure?","lesson":"The ring separates two keeper-held fields. Its outer edge offers short returns; its inner edge supports larger enclosures. Both fields matter to the clear.","counterplay":"Watch the keeper in the field you are entering. Move along reclaimed ring ground to shorten the exposed route, and close before a keeper reaches your line.","captureConsequence":"An outer connection creates new launch angles but cannot claim the occupied courtyard. An inward capture creates shorter interior returns without clearing the outside for free.","introduces":[],"practices":["foundations","enemy-seeded-closure","travelling-trail-impact"],"combines":["foundations","enemy-seeded-closure"],"memorableMoment":"A short outer bridge changes the next launch, then an inward enclosure reveals the courtyard at a different scale.","mastery":"Complete an inward cut and an outward cut.","durationSeconds":[60,140],"difficulty":{"band":2,"planning":2,"execution":2,"threatDensity":2,"timePressure":0,"mechanicLoad":2,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-courtyard-return"}},{"format":"MissionDesignV1","id":"long-way-home","revision":"horizon-cultural-joins-1","name":"Long way home","map":{"id":"long-way-home-map","revision":"horizon-cultural-joins-1"},"spawnId":"home","modes":["solo","versus"],"actors":[{"id":"north","role":"field-keeper","tier":"measured","x":22.5,"y":5.5,"heading":[1,1]},{"id":"south","role":"field-keeper","tier":"measured","x":49.5,"y":30.5,"heading":[-1,-1]}],"objectives":[],"bonuses":[],"coverage":0.72,"timeLimitSeconds":0,"design":{"routeDecision":"Join through the upper shoulder group for the shorter first return, or descend to the offset gathered group for a longer line that approaches the far shoulder?","lesson":"Offset paired groups around a strong side-to-side joining axis make route planning visible while retaining only known foundation rules.","counterplay":"Use the west shoulder as safe staging, then commit above or below only when the corresponding keeper is travelling away from the intended line.","captureConsequence":"The upper join leaves a broad lower region; the lower gathered join leaves a different upper region and a closer angle to the east shoulder.","introduces":[],"practices":["foundations","enemy-seeded-closure","travelling-trail-impact"],"combines":["foundations","enemy-seeded-closure"],"memorableMoment":"A Verkhovyna-informed shoulder construction resolves into two offset joining groups rather than a symmetric cross.","mastery":"Reach both offset joins from the west shoulder without losing a life.","durationSeconds":[75,150],"difficulty":{"band":2,"planning":2,"execution":2,"threatDensity":2,"timePressure":0,"mechanicLoad":2,"coordination":0}},"presentation":{"themeId":"horizon-actors-v1","backgroundAssetId":"horizon-long-way-home"}}],"campaigns":[{"format":"CampaignDesignV1","id":"prologue","revision":"erosion-counterplay-review-1","name":"Prologue","band":1,"missionIds":["first-return","choose-your-share","two-keepers"]},{"format":"CampaignDesignV1","id":"horizon-school","revision":"early-cultural-routes-1","name":"Horizon School","band":1,"missionIds":["nearby-shore","island-outpost","stepping-stones","two-bays","courtyard-return","long-way-home"]}],"packs":[{"format":"PackDesignV1","id":"journey-opening","revision":"early-cultural-routes-1","name":"Opening candidates","campaignIds":["prologue","horizon-school"]}],"assets":[{"format":"AssetRevisionV1","id":"horizon-first-return","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/first-return.png","sha256":"3acf496d9a6bc9db2f83ac01d8255223b3913e7ae0a157e48559ac981c80b95d","bytes":2366738,"width":1774,"height":887,"alt":"Warm morning light over a teal bay, rocky shore and a small sandstone observatory.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-choose-your-share","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/choose-your-share.png","sha256":"d2d9d57da0c25d1e264387d24d2ecad2e88ad43b77db3934039f1291edd017ae","bytes":2828010,"width":1774,"height":887,"alt":"An estuary with broad sandbanks, a wooden ferry and a distant sandstone village.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-nearby-shore","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/nearby-shore.png","sha256":"f24ba2aac769b952f0ad8de13193627c76e6a39bcd8db9a5ddb3e16ded0f26d5","bytes":2618614,"width":1774,"height":887,"alt":"A small botanical glasshouse on a rocky island beside a quiet sandy shore.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-two-keepers","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/two-keepers.png","sha256":"ba9c3c428fbd44e1fd0b7e5ba70bae0abdd11faa65ae219042a7a6d196bce5f6","bytes":2572761,"width":1774,"height":887,"alt":"Two weathered watchtowers face each other across a broad sea channel.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-island-outpost","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/island-outpost.png","sha256":"3fb163cde27b9496290a07a106e11737c369dd77b527e5985a1e3c48d9476b46","bytes":2484871,"width":1774,"height":887,"alt":"A cliff island weather station, natural tide arch and old stone jetty.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-stepping-stones","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/stepping-stones.png","sha256":"aa9eadbc166df2bf78030ecec8e24e920d6a254d7e66143f380c1d263005cc36","bytes":2597944,"width":1774,"height":887,"alt":"Irregular stone shelves and salt flowers lead across a misty marsh toward a reed-roof birdwatching shelter.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-two-bays","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/two-bays.png","sha256":"589632c9b912ba2b07648c9c0de7c0768e61d5938a1993414d7b36ac650b5118","bytes":2669903,"width":1774,"height":887,"alt":"A rounded headland separates a sheltered fishing hamlet from sea caves and a crescent beach.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-courtyard-return","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/courtyard-return.png","sha256":"7c4ed0ae6f76c49b5dbe1361b5ff0b2c17dce08aeb2c0f6aece08890c373123a","bytes":2701528,"width":1774,"height":887,"alt":"A sandstone courtyard holds a reflecting pool, wind-shaped tree and stone bench beside an arch opening to the sea.","review":"candidate"},{"format":"AssetRevisionV1","id":"horizon-long-way-home","revision":"r1","kind":"reveal-background","path":"content-design/assets/horizon-r1/long-way-home.png","sha256":"0219e5fbe164647cd1ba0cd2dff019df8d0b9fc334780b06b53693564c1aaadf","bytes":2584488,"width":1774,"height":887,"alt":"A weathered boat shed and driftwood overlook a quiet evening inlet and a far-shore village.","review":"candidate"}]}