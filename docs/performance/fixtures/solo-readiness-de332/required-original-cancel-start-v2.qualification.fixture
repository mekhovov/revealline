  "id": "required-original-cancel-first-return-v1",
  "coverage": [
    "Correctness-only: exact authored original acquisition is held; public Escape closes idle Home, and visible Start joins the flight picture owner. A second real Escape must cancel the still-current busy attempt and actual native fetch.",
    "No automatic Start across a500ms inactive checkpoint; a fresh public Start must prepare the exact original and complete meaningful movement plus strict replay.",
    "Held response tests acquisition cancellation, not decoder stalls. All numerical and failed-response evidence remains unchanged."
  ],
  "actions": [
    {
      "type": "key",
      "key": "Escape",
      "ms": 1,
      "label": "close-idle-home"
    },
    {
      "type": "expect",
      "selector": "body:not(:has(dialog[open])) #start-button:not(:disabled)",
      "timeoutMs": 5000,
      "label": "idle-home-actually-closed"
    },
    {
      "type": "click",
      "selector": "#start-button",
      "timeoutMs": 5000,
      "label": "required-original-first-start"
    },
    {
      "type": "expect",
      "selector": "body:not([data-flight-state=\"running\"]):not(:has(dialog[open])) #flight-preparation-status[data-state=\"busy\"]",
