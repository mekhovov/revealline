      "group": "prepared"
    },
    {
      "type": "click",
      "selector": "#start-button",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "key",
