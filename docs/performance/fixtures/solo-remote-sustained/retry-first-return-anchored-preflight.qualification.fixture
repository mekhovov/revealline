      "label": "first-return-anchor-top"
    },
    {
      "type": "key",
      "key": "ArrowDown",
      "ms": 8000,
      "label": "first-return-close-at-bottom"
    },
    {
      "type": "result",
      "outcome": "won",
      "timeoutMs": 20000
    },
    {
      "type": "snapshot",
      "group": "completed"
    },
    {
      "type": "click",
      "selector": "#retry-button",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "key",
