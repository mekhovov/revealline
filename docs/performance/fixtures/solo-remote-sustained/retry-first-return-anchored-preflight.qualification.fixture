{
  "format": "SoloQualificationV1",
  "id": "first-return-anchored-retry-native-preflight-v1",
  "kind": "lifecycle",
  "timeoutMs": 240000,
  "entryPath": "playground/",
  "readySelector": "#import-file",
  "readyHiddenSelector": "#boot-status",
  "coverage": [
    "One imported anchored First Return win, one public Retry, and a second anchored win",
    "Inline short native preflight; no sustained-duration or twenty-Retry qualification",
