{
  "format": "SoloQualificationV1",
  "id": "first-fracture-capture-erosion-v2",
  "kind": "performance",
  "timeoutMs": 240000,
  "entryPath": "playground/",
  "readySelector": "#import-file",
  "coverage": [
    "captures",
    "earned-erosion"
  ],
  "replayRequirements": {
    "closures": 1,
    "eroded": 1
  },
  "actions": [
    {
      "type": "expect",
      "selector": "#preview-load-status[data-state=\"ready\"]",
      "timeoutMs": 60000
    },
    {
      "type": "upload",
      "selector": "#import-file",
      "file": "first-fracture.xonix.json",
      "acceptedLevelSelector": "#level-json"
    },
    {
      "type": "click",
      "selector": "#preview-button",
      "timeoutMs": 60000
    },
    {
      "type": "expect",
      "selector": "#preview-load-status[data-state=\"ready\"]",
      "timeoutMs": 60000
    },
    {
      "type": "follow",
      "selector": "#open-preview",
      "preparationStatusSelector": "[data-presentation-status=\"auxiliary\"]",
      "timeoutMs": 120000
    },
    {
      "type": "snapshot",
      "group": "prepared"
    },
    {
      "type": "click",
      "selector": "#start-button",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "key",
      "key": "ArrowDown",
      "ms": 1600
    },
    {
      "type": "wait",
      "ms": 15000
    },
    {
      "type": "wait",
      "phase": "running"
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused"
    },
    {
      "type": "snapshot",
      "group": "after-workload"
    },
    {
      "type": "exportReplay"
    }
  ],
  "readyHiddenSelector": "#boot-status",
