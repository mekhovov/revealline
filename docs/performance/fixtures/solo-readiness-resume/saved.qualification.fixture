{
  "format": "SoloQualificationV1",
  "id": "saved-resume-first-return-readiness-v1",
  "kind": "lifecycle",
  "timeoutMs": 240000,
  "query": {
    "journey": "opening"
  },
  "coverage": [
    "Public saved Resume readiness; continuous steering direction is retained or restored according to existing ownership",
    "No new discrete input in the fixed post-Resume wait",
    "Short correctness diagnostic only; all numerical statuses retained"
  ],
  "replayRequirements": {
    "movingTicks": 120
  },
  "actions": [
    {
      "type": "click",
      "selector": "#shell-featured",
      "timeoutMs": 60000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 60000
    },
    {
      "type": "key",
      "key": "ArrowLeft",
      "ms": 1200,
      "label": "safe-border-before-pause"
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused",
      "timeoutMs": 10000
    },
    {
      "type": "snapshot",
      "group": "before-resume"
    },
    {
      "type": "exportReplay",
      "label": "before-resume"
    },
    {
      "type": "reload",
      "timeoutMs": 60000
    },
    {
      "type": "expect",
      "selector": "#shell-home[open]",
      "timeoutMs": 15000
    },
    {
      "type": "key",
      "key": "Escape",
      "ms": 1
    },
    {
      "type": "expect",
      "selector": "body:not(:has(#shell-home[open])) #continue-saved:not(:disabled)",
      "timeoutMs": 15000
    },
    {
      "type": "click",
      "selector": "#continue-saved",
      "timeoutMs": 15000
    },
    {
      "type": "expect",
      "selector": "#game-overlay[data-kind=\"pause\"]",
      "timeoutMs": 15000
    },
    {
      "type": "wait",
      "phase": "paused",
      "timeoutMs": 15000
    },
    {
      "type": "snapshot",
      "group": "saved-restored-before-resume"
    },
    {
      "type": "exportReplay",
      "label": "saved-restored"
    },
    {
      "type": "click",
      "selector": "#replay-dialog .dialog-close[data-close=\"replay-dialog\"]"
    },
    {
      "type": "click",
      "selector": "[data-close=\"shell-workshop-dialog\"]"
    },
    {
      "type": "click",
      "selector": "[data-close=\"settings-dialog\"]"
    },
    {
      "type": "key",
      "key": "Escape",
      "ms": 1
    },
    {
      "type": "expect",
      "selector": "body:not(:has(dialog[open])) #start-button:not(:disabled)",
      "timeoutMs": 15000
    },
    {
      "type": "click",
      "selector": "#start-button",
      "timeoutMs": 15000
    },
    {
      "type": "wait",
      "phase": "running",
      "timeoutMs": 15000
    },
    {
      "type": "wait",
      "ms": 400,
      "label": "resume-no-new-input"
    },
    {
      "type": "click",
      "selector": "#pause-button"
    },
    {
      "type": "wait",
      "phase": "paused",
      "timeoutMs": 10000
    },
    {
      "type": "snapshot",
      "group": "after-resume"
    },
    {
      "type": "exportReplay",
      "label": "after-resume"
    }
  ],
  "expectedReplayDefinition": {
