      "selectedComparisonOverlay": {
        "selectedCallReplacements": [
          {
            "line": 225,
            "before": "  assert.equal(p.doc.activeElement, p.$('race-help'));\n",
            "after": "  boundedIdentity(p.doc.activeElement, p.$('race-help'));\n"
          }
        ],
        "helperInsertion": {
          "after": "import assert from 'node:assert/strict';\n",
          "source": "// Diagnostic copy only: bounded immediate stage markers and exact identity truth.\nlet encounterStageCount = 0;\nfunction encounterStage(name) {\n  if (encounterStageCount++ < 32)\n    process.stderr.write('# SOLO_COUCH_CASE5 ' + name + '\\n');\n}\nfunction boundedIdentity(actual, expected, message) {\n  encounterStage('identity-begin');\n  const same = Object.is(actual, expected);\n  encounterStage('identity-result-' + same);\n  if (same) return;\n  const label = (value) => value === null ? 'null' : value === undefined ? 'undefined' :\n    [value.tagName, value.id].filter((part) => typeof part === 'string')\n      .map((part) => part.slice(0, 80)).join('#') || typeof value;\n  assert.ok(false, (message ?? 'Strict identity mismatch.') +\n    ' Actual: ' + label(actual) + '; expected: ' + label(expected) + '.');\n}\n"
        },
        "caseStageInsertions": [
          {
            "before": "test('reading encounter guidance after the real time limit retains both result boards', async (t) => {\n",
            "after": "test('reading encounter guidance after the real time limit retains both result boards', async (t) => {\n  encounterStage('case5-enter');\n"
          },
          {
            "before": "  const p = await host(t, combatLevel('scout'));\n",
            "after": "  const p = await host(t, combatLevel('scout'));\n  encounterStage('host-ready');\n"
          },
          {
            "before": "  await start(p);\n",
            "after": "  await start(p);\n  encounterStage('start-ready');\n"
          },
          {
            "before": "  assert.equal(p.doc.body.dataset.couchStatus, 'finished');\n  const checkpoint",
            "after": "  encounterStage('terminal-frames-returned');\n  assert.equal(p.doc.body.dataset.couchStatus, 'finished');\n  const checkpoint"
          },
          {
            "before": "  p.$('race-help').click();\n",
            "after": "  p.$('race-help').click();\n  encounterStage('help-open');\n"
          },
          {
            "before": "  p.frames(60);\n",
            "after": "  encounterStage('reading-entered');\n  p.frames(60);\n  encounterStage('reading-frames-returned');\n"
          },
          {
            "before": "  assert.equal(p.doc.body.dataset.couchStatus, 'finished');\n  assert.deepEqual",
            "after": "  encounterStage('back-activation-returned');\n  assert.equal(p.doc.body.dataset.couchStatus, 'finished');\n  encounterStage('checkpoint-comparison-begin');\n  assert.deepEqual"
          },
          {
            "before": "  assert.deepEqual(p.renders, boards);\n",
            "after": "  encounterStage('checkpoint-comparison-complete');\n  assert.deepEqual(p.renders, boards);\n  encounterStage('boards-comparison-complete');\n"
          },
          {
            "before": "  boundedIdentity(p.doc.activeElement, p.$('race-help'));\n",
            "after": "  boundedIdentity(p.doc.activeElement, p.$('race-help'));\n  encounterStage('case5-complete');\n"
          }
        ],
        "diagnosticSHA256": "463c2ddfac9f7bd384d8c4e41dc9116e3e9257b0624d7060d2548f1f60a3b6b1",
        "scope": "One exact strict identity decision, all terminal/checkpoint/board/storage assertions unchanged; bounded fixed stage markers; filtered diagnostic only, zero canonical credit."
      },
