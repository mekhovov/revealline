+
+test('actual Versus fallback refits wrapping statistics after a normal capture before either seat paints', async (t) => {
+  let geometryReads = 0;
+  const { page, rendering } = await fixture(t, {
+    resizeObserver: false,
+    onMount({ document }) {
+      for (const seat of [0, 1]) {
+        const arena = document.getElementById(`race-canvas-${seat}`).parentElement;
+        arena.clientWidth = 600;
+        Object.defineProperty(arena, 'clientHeight', {
+          configurable: true,
+          get() {
+            geometryReads++;
+            const text = document.getElementById(`racer-stats-${seat}`).textContent;
+            // Finite layout boundary: earned points make the real HUD wrap.
+            // Neither the fixture nor this getter edits a run or a HUD label.
+            const points = Number(/(\d+) points/.exec(text)?.[1] || 0);
+            return points > 0 ? [225, 234][seat] : 300;
+          },
+        });
+      }
+    },
+  });
+  assert.equal(rendering.observers.length, 0);
+  assert.deepEqual(page.drawOptions.map((options) => options.displayCSSWidth), [400, 400]);
+  const runs = [...page.renders],
+    pictures = page.drawOptions.map((options) => options.backdrop),
+    before = runs.map((run) => ({ score: run.score, coverage: run.coverage })),
+    capturePaints = [],
+    onDraw = rendering.onDraw;
+  rendering.onDraw = (frame) => {
+    onDraw(frame);
+    if (frame.run.score > before[frame.seat].score && capturePaints.length < 2)
+      capturePaints.push({
+        seat: frame.seat,
+        width: frame.options.displayCSSWidth,
+        points: [0, 1].map((seat) => page.$(`racer-stats-${seat}`).textContent),
+      });
+  };
+  function steer(keys, reached) {
+    for (const key of keys) page.key(key);
+    let frames = 0;
+    while (!reached() && frames++ < 120) page.frame(1000 / 120);
+    for (const key of keys) page.key(key, false);
+    assert.ok(reached(), 'The authored opening must be reachable through ordinary input.');
+  }
+  steer(['KeyS', 'ArrowDown'], () => runs.every((run) => run.player.y >= 5.5));
+  steer(['KeyD', 'ArrowRight'], () => runs.every((run) => run.player.x >= 30.5));
+  steer(['KeyW', 'ArrowUp'], () => runs.every((run) => run.score > 0));
+  for (const seat of [0, 1]) {
+    assert.equal(page.renders[seat], runs[seat]);
+    assert.equal(page.drawOptions[seat].backdrop, pictures[seat]);
+    assert.ok(runs[seat].score > before[seat].score);
+    assert.ok(runs[seat].coverage > before[seat].coverage);
+    assert.equal(runs[seat].lives, 3);
+  }
+  assert.deepEqual(capturePaints.map(({ seat, width }) => ({ seat, width })), [
+    { seat: 0, width: 300 },
+    { seat: 1, width: 312 },
+  ]);
+  for (const paint of capturePaints)
+    assert.ok(paint.points.every((text) => Number(/(\d+) points/.exec(text)?.[1]) > 0));
+  const checkpoint = page.checkpoint(),
+    reads = geometryReads;
+  page.frames(3, 0);
+  assert.equal(geometryReads, reads, 'Unchanged HUD text must not measure on ordinary frames.');
+  assert.deepEqual(page.checkpoint(), checkpoint);
+});
