+  const returnLink = doc.getElementById('about-return'),
+    status = doc.getElementById('about-navigation-status'),
+    listeners = [];
+  let disposed = false,
+    cached = false,
+    blurred = doc.hasFocus?.() === false,
+    frameId = null,
+    lastStatus = null;
