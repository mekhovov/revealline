+      stop();
+    }
+  });
+  listen(win, 'pageshow', (event) => {
+    if (!event.persisted || disposed) return;
+    cached = false;
+    blurred = doc.hasFocus?.() === false;
+    clear();
+    schedule();
+  });
+  schedule();
+  return { current: () => !disposed, dispose };
+}
