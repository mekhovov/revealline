+  };
+  function poll(timeMs) {
+    frameId = null;
+    if (!foreground()) {
+      clear();
+      return;
+    }
+    const sample = router.sample({ scope: 'about', timeMs });
+    if (sample.disconnected) navigation.clear();
+    if (sample.status.code !== lastStatus) {
