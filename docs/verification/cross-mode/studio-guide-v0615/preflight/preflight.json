  "actionableFindings": [
    {
      "priority": "P2",
      "id": "studio-guide-held-escape",
      "path": "authoring/asset-studio/guide.mjs",
      "lines": [
        31,
        32,
        35
      ],
      "title": "A held Escape can cancel the operation after closing its guide",
      "trigger": "Start or encode remains pending; focus Close in the open guide; press and hold Escape. The first keydown closes the guide and moves focus to its summary. A repeat keydown now has guide.open=false, so the guide listener returns and Studio\u2019s window keydown handler calls operations.cancel().",
      "impact": "A single intended guide-close press can abort preparation or detach waiting for an in-flight save. This violates the passive help/operation preservation contract.",
      "sourceEvidence": "guide keydown returns for !guide.open and never distinguishes repeat; studio.mjs line114-115 cancels on every Escape. No test execution performed by reviewer.",
      "requiredCorrection": "Keep a single held guide-close key from reaching authoring cancellation while retaining a separate fresh Escape outside/after the guide as normal operation cancellation. Use the smallest host-owned input boundary and clean it up on terminal departure.",
      "requiredTests": "Add a meaningful held-operation actual-host sequence plus helper coverage: initial guide Escape, repeated Escape from the focused closed summary, release, then a fresh Escape. Repeats must preserve operation/status/prepared bytes; fresh Escape retains deliberate cancellation. Also preserve unrelated authoring input and terminal cleanup.",
      "existingGap": "The existing helper test verifies a second fresh Escape but its helper supplies no repeat value; actual-host closeGuide(true) emits only one keydown."
    }
  ],
  "behaviorReview": [
    "Passive native disclosure sits before asynchronous inventory and inspector content, outside mutation/inert regions. It does not create storage, operation or preview ownership.",
    "Close is hidden until its handler mounts. Current focus checks are synchronous, owned and foreground; external focus is preserved and handlers dispose only on terminal pagehide.",
    "Retained guide copy correctly separates prepare, stage, save, export, import, review and publication. Original bytes/history and player saves remain explicit.",
    "Guide provides native keyboard/pointer help, not new controller ownership. Full Studio controller authoring and physical-device navigation are not proven."
  ],
