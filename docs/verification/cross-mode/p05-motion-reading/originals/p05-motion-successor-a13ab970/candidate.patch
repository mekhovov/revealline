+:root {
+  color-scheme: light;
+  --paper: #f4f2e9;
+  --ink: #1f2a2d;
+  --muted: #697575;
+  --line: #d7ddd6;
+  --accent: #efc74f;
+  --wall: #82a8b5;
+  --slow: #a0ad6a;
+  --danger: #d77b68;
+  --arena: #0f1b23;
+  font-family: var(--fk-font-ui, sans-serif);
+  font-synthesis: none;
+}
+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+}
+button,
+input,
+select {
+  font: inherit;
+}
+button,
+select,
+input[type='range'],
+input[type='checkbox'] {
+  cursor: pointer;
+}
+button {
+  color: inherit;
+}
+button:focus-visible,
+select:focus-visible,
+input:focus-visible,
+canvas:focus-visible,
+a:focus-visible {
+  outline: 3px solid #4b849d;
+  outline-offset: 4px;
+}
+button:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+[hidden] {
+  display: none !important;
+}
+.workspace {
+  max-width: 1480px;
+  margin: auto;
+  padding: 35px 42px 22px;
+}
+.page-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-end;
+  gap: 28px;
+  padding-bottom: 27px;
+  border-bottom: 1px solid var(--line);
+  margin-bottom: 26px;
+}
+.eyebrow,
+.section-index,
+.arena-heading,
+.readout-label,
+.page-footer,
+.scope-note,
+.asset-status,
+.control-hint,
+.material-legend {
+  font-family: var(--fk-font-mono, monospace);
+}
+.eyebrow {
+  font-size: 10px;
+  text-transform: uppercase;
+  letter-spacing: 0.16em;
+  margin: 0 0 11px;
+  color: var(--muted);
+}
+h1 {
+  font-family: var(--fk-font-ui, sans-serif);
+  font-size: clamp(25px, 2.7vw, 39px);
+  font-weight: 600;
+  letter-spacing: -0.035em;
+  line-height: 1.05;
+  margin: 0;
+}
+.scope-note {
+  margin: 0;
+  font-size: 10px;
+  line-height: 1.7;
+  white-space: nowrap;
+}
+.scope-note > span:last-child {
+  display: block;
+  color: var(--muted);
+}
+.status-dot {
+  display: inline-block;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: #77876f;
+  margin-right: 7px;
+}
+.lab-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 272px;
+  gap: 32px;
+}
+.preview-column {
+  min-width: 0;
+}
+.arena-heading {
+  display: flex;
+  justify-content: space-between;
+  font-size: 10px;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  margin-bottom: 12px;
+}
+.muted {
+  color: var(--muted);
+}
+.arena-shell {
+  position: relative;
+  background: var(--arena);
+  border: 1px solid #31414a;
+  box-shadow: 0 8px 20px #14252b10;
+  overflow: hidden;
+}
+.arena-shell canvas {
+  width: 100%;
+  aspect-ratio: 4/3;
+  display: block;
+  touch-action: none;
+  outline-offset: -4px;
+}
+.arena-caption {
+  position: absolute;
+  bottom: 13px;
+  left: 16px;
+  right: 16px;
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  pointer-events: none;
+  color: #b9c3c8;
+  font: 9px var(--fk-font-mono, monospace);
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+  text-shadow: 0 1px 3px #000;
+}
+.arena-caption span {
+  background: #0a151cc4;
+  padding: 5px 7px;
+  border: 1px solid #718c9728;
+}
+.telemetry {
+  display: grid;
+  grid-template-columns: 1.1fr 1fr 1fr;
+  border-bottom: 1px solid var(--line);
+  padding: 18px 0 15px;
+  gap: 18px;
+}
+.telemetry-cell {
+  position: relative;
+  min-width: 0;
+}
+.telemetry-cell + .telemetry-cell {
+  border-left: 1px solid var(--line);
+  padding-left: 20px;
+}
+.readout-label {
+  display: block;
+  color: var(--muted);
+  font-size: 9px;
+  letter-spacing: 0.06em;
