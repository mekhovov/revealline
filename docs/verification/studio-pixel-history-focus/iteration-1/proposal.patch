+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mountSpritePanel } from '../../authoring/asset-studio/sprite-panel.mjs';
+import { Document, Element } from './helpers/couch-dom.mjs';
+
+function fixture(t) {
+  const doc = new Document();
+  const ids = [
+    'sprite-canvas',
+    'sprite-color',
+    'sprite-alpha',
+    'sprite-zoom',
+    'sprite-tool',
+    'sprite-undo',
+    'sprite-redo',
+    'sprite-cursor',
+    'replace-palette-color',
+    'replace-color',
+    'move-selection',
+    'selection-dx',
+    'selection-dy',
+    'use-sprite',
+    'sprite-workbench',
+    'sprite-palette',
+    'other-control',
+  ];
+  for (const id of ids) {
+    const node = new Element(doc, id === 'sprite-canvas' ? 'canvas' : 'button');
+    node.id = id;
+    doc.body.append(node);
+    // Model the observed browser boundary: disabling a focused native control
+    // loses focus. Geometry and actual browser layout are not modeled.
+    let disabled = false;
+    Object.defineProperty(node, 'disabled', {
+      get: () => disabled,
+      set(value) {
+        disabled = !!value;
+        if (disabled && doc.activeElement === node) doc.activeElement = doc.body;
+      },
+    });
+    node.focus = () => {
+      if (node.disabled) return;
+      const previous = doc.activeElement;
+      doc.activeElement = node;
+      if (previous !== node) {
+        previous.emit?.('blur', { bubbles: false });
+        node.emit('focus', { bubbles: false });
+      }
+      node.emit('focusin');
+    };
+  }
+  const $ = (id) => doc.getElementById(id);
+  $('sprite-color').value = '#f07879';
+  $('sprite-alpha').value = '255';
+  $('sprite-zoom').value = '8';
+  $('sprite-tool').value = 'pencil';
+  let pixels,
+    duringPaint = null;
+  $('sprite-canvas').getContext = () => ({
+    putImageData(image) {
+      pixels = new Uint8ClampedArray(image.data);
+      const callback = duringPaint;
+      duringPaint = null;
+      callback?.();
+    },
+    fillRect() {},
+    strokeRect() {},
+  });
+  const previous = new Map(
+    ['document', 'ImageData'].map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]),
+  );
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: doc });
+  Object.defineProperty(globalThis, 'ImageData', {
+    configurable: true,
+    value: class {
+      constructor(data, width, height) {
+        Object.assign(this, { data, width, height });
+      }
+    },
+  });
+  t.after(() => {
+    for (const [key, descriptor] of previous) {
+      if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+      else delete globalThis[key];
+    }
+  });
+  const errors = [];
+  const panel = mountSpritePanel({
+    onPrepare() {},
+    onError: (error) => errors.push(error),
+    runOperation() {
+      assert.fail('History navigation must not prepare an upload.');
+    },
+  });
+  panel.open(2, 2);
+  t.after(() => assert.deepEqual(errors, []));
+  const key = (key, extra = {}) =>
+    $('sprite-canvas').emit('keydown', { key, code: key === ' ' ? 'Space' : key, ...extra });
+  const paint = () => {
+    $('sprite-canvas').focus();
+    key(' ');
+  };
+  return {
+    $,
+    doc,
+    panel,
+    key,
+    paint,
+    pixels: () => Array.from(pixels),
+    duringPaint: (fn) => {
+      duringPaint = fn;
+    },
+  };
+}
+
+for (const action of ['undo', 'redo']) {
+  test(`focused ${action} endpoint transfers to enabled opposite history action without changing pixels`, (t) => {
+    const f = fixture(t);
+    const blank = f.pixels();
+    f.paint();
+    const painted = f.pixels();
+    assert.notDeepEqual(painted, blank);
+    if (action === 'redo') f.$('sprite-undo').click();
+    const source = f.$('sprite-' + action);
+    const target = f.$('sprite-' + (action === 'undo' ? 'redo' : 'undo'));
+    source.focus();
+    source.click();
+    assert.equal(f.doc.activeElement === target, true);
+    assert.equal(source.disabled, true);
+    assert.equal(target.disabled, false);
+    assert.deepEqual(f.pixels(), action === 'undo' ? blank : painted);
+    assert.equal(f.panel.hasEdits(), action === 'redo');
+  });
+}
+
+test('an Undo with remaining history retains its own focus', (t) => {
+  const f = fixture(t);
+  f.paint();
+  const first = f.pixels();
+  f.key('ArrowRight');
+  f.key(' ');
+  f.$('sprite-undo').focus();
+  f.$('sprite-undo').click();
+  assert.equal(f.doc.activeElement === f.$('sprite-undo'), true);
+  assert.equal(f.$('sprite-undo').disabled, false);
+  assert.deepEqual(f.pixels(), first);
+});
+
+for (const modifier of ['ctrlKey', 'metaKey']) {
+  test(`canvas ${modifier} Undo/Redo keeps keyboard ownership and exact pixels`, (t) => {
+    const f = fixture(t);
+    const blank = f.pixels();
+    f.paint();
+    const painted = f.pixels();
+    f.key('z', { [modifier]: true });
+    assert.equal(f.doc.activeElement === f.$('sprite-canvas'), true);
+    assert.deepEqual(f.pixels(), blank);
+    f.key('z', { [modifier]: true, shiftKey: true });
+    assert.equal(f.doc.activeElement === f.$('sprite-canvas'), true);
+    assert.deepEqual(f.pixels(), painted);
+  });
+}
+
+test('history operations do not claim another control focus', (t) => {
+  const f = fixture(t);
+  f.paint();
+  f.$('other-control').focus();
+  f.$('sprite-undo').click();
+  assert.equal(f.doc.activeElement === f.$('other-control'), true);
+  f.$('sprite-redo').click();
+  assert.equal(f.doc.activeElement === f.$('other-control'), true);
+});
+
+test('opening fresh history falls back to canvas only from an owned endpoint', (t) => {
+  const f = fixture(t);
+  f.paint();
+  f.$('sprite-undo').focus();
+  f.panel.open(2, 2);
+  assert.equal(f.doc.activeElement === f.$('sprite-canvas'), true);
+  assert.equal(f.$('sprite-undo').disabled, true);
+  assert.equal(f.$('sprite-redo').disabled, true);
+  assert.equal(f.panel.hasEdits(), false);
+  f.$('other-control').focus();
+  f.panel.open(2, 2);
+  assert.equal(f.doc.activeElement === f.$('other-control'), true);
+});
+
+test('a newer focus established during repaint is not reclaimed', (t) => {
+  const f = fixture(t);
+  f.paint();
+  f.$('sprite-undo').focus();
+  f.duringPaint(() => f.$('other-control').focus());
+  f.$('sprite-undo').click();
+  assert.equal(f.doc.activeElement === f.$('other-control'), true);
+});
+
+test('a successor focus callback can choose another control without a later handoff', (t) => {
+  const f = fixture(t);
+  f.paint();
+  f.$('sprite-redo').addEventListener('focus', () => f.$('other-control').focus());
+  f.$('sprite-undo').focus();
+  f.$('sprite-undo').click();
+  assert.equal(f.doc.activeElement === f.$('other-control'), true);
+});
