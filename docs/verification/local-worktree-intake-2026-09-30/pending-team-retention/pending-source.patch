+test('published v0.78 Team envelope retains exact fpv50 picture and audio after a newer default', async () => {
+  const f = await fixture({ pageRevision: 51, retainedRevision: 50 });
+  const originalReceipt = canonicalJSON(f.imported.owner.receipt);
+  const originalBytes = Buffer.from(await f.imported.input.arrayBuffer());
+  const result = await f.owner.select(f.request);
+  assert.equal(result.snapshot, f.oldSnapshot);
+  assert.equal(result.choice.themeRevision, 50);
+  assert.equal((await f.owner.readAudio('audio.capture')).snapshot, f.oldSnapshot);
+  assert.equal(await f.owner.select(f.request), result);
+  assert.equal(f.owner.confirm(f.request), result);
+  assert.equal(canonicalJSON(f.imported.owner.receipt), originalReceipt);
+  assert.deepEqual(
+    Buffer.from(await exportCoopPresentationEnvelope(f.imported.owner).arrayBuffer()),
