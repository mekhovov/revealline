{
  "name": "revealline",
  "version": "0.132.5",
  "private": true,
  "type": "module",
  "description": "Configurable territory-capture game and authoring playground",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node scripts/game-cli.mjs serve --port 8768",
    "test": "node scripts/game-cli.mjs test",
    "test:creator-feature": "node scripts/check-creator-feature.mjs",
    "validate": "npm run i18n:check && node scripts/game-cli.mjs validate && node scripts/check-presentation-metadata.mjs",
    "lint": "eslint \"game/**/*.mjs\" \"scripts/**/*.mjs\" \"site/**/*.mjs\" \"platforms/**/*.{mjs,js}\" eslint.config.mjs --max-warnings 0",
    "build": "node scripts/game-cli.mjs build",
    "build:pages": "node scripts/build-pages.mjs",
    "release": "node scripts/game-cli.mjs release-snapshot",
    "format": "prettier --write \"game/**/*.{mjs,css,html,json}\" \"scripts/*.mjs\" \"site/**/*.{mjs,css,html}\"",
    "format:check": "prettier --check \"game/**/*.{mjs,css,html,json}\" \"scripts/*.mjs\" \"site/**/*.{mjs,css,html}\"",
    "native:stage": "node scripts/native-cli.mjs stage",
    "native:verify": "node scripts/native-cli.mjs verify",
    "desktop:start": "npm --prefix platforms/desktop start",
    "desktop:package": "npm --prefix platforms/desktop run package",
    "ios:doctor": "npm --prefix platforms/ios run doctor",
    "ios:sync": "npm --prefix platforms/ios run native:sync",
    "format:native": "prettier --write \"platforms/desktop/*.mjs\" \"platforms/desktop/test/*.mjs\" \"platforms/ios/{bridge,scripts,test,diagnostics}/*.{mjs,js,html,css}\"",
    "format:native:check": "prettier --check \"platforms/desktop/*.mjs\" \"platforms/desktop/test/*.mjs\" \"platforms/ios/{bridge,scripts,test,diagnostics}/*.{mjs,js,html,css}\"",
    "i18n:build": "node scripts/localization.mjs build",
    "i18n:check": "node scripts/localization.mjs check",
    "i18n:extract": "node scripts/localization.mjs extract",
    "i18n:audit": "node scripts/localization.mjs audit",
    "i18n:check:main": "node scripts/localization-main.mjs && npm run i18n:check",
    "company:check": "node scripts/produce-company-content.mjs --check && node scripts/check-edition-source.mjs .",
    "company:test": "node --test game/test/company-*.test.mjs game/test/edition*.test.mjs game/test/runtime-content-provider.test.mjs game/test/body-backing.test.mjs game/test/presentation-player-projection.test.mjs publishing/edition-admission.test.mjs scripts/test-edition-offline.mjs publishing/edition-promotion.test.mjs scripts/test-bundle-editions.mjs",
    "company:studio": "node scripts/company-studio.mjs",
    "company:bundle": "node scripts/bundle-editions.mjs",
    "company:promote": "node scripts/publish-editions.mjs"
  },
  "dependencies": {
    "mediabunny": "1.59.1",
    "i18next": "26.4.2",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "lz-string": "1.5.0",
    "parse5": "8.0.1",
    "prettier": "3.6.2"
  }
}
