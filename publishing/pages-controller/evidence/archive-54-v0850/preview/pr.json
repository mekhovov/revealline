ailability; then separate reviewed parent-owned main-selector update preserving every historical route. No source/tag/asset or main-selector mutation is part of this PR.\n\nCurrent status: preview pending, merge/deployment/public admission not claimed. Gameplay/offline/device matrices remain waived or deferred, not passed.\n","created_at":"2026-09-22T23:03:45Z","updated_at":"2026-09-22T23:03:45Z","closed_at":null,"merged_at":null,"merge_commit_sha":"f0487b81fc25eccc9c9ea84658aef3548b47144b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/mekhovov/revealline-archive-54/pulls/1/commits","review_comments_url":"https://api.github.com/repos/mekhovov/revealline-archive-54/pulls/1/comments","review_comment_url":"https://api.github.com/repos/mekhovov/revealline-archive-54/pulls/comments{/number}","comments_url":"https://api.github.com/repos/mekhovov/revealline-archive-54/issues/1/comments","statuses_url":"https://api.github.com/repos/mekhovov/revealline-archive-54/statuses/75dadb2dbb48e723ee7c268b18acefb1fa52e776","head":{"label":"mekhovov:codex/preserve-v0850-archive54","ref":"codex/preserve-v0850-archive54","sha":"75dadb2dbb48e723ee7c268b18acefb1fa52e776","user":{"login":"mekhovov","id":194539,"node_id":"MDQ6VXNlcjE5NDUzOQ==","avatar_url":"https://avatars.githubusercontent.com/u/194539?v=4","gravatar_id":"","url":"https://api.github.com/users/mekhovov","html_url":"https://github.com/mekhovov","followers_url":"https://api.github.com/users/mekhovov/followers","following_url":"https://api.github.com/users/mekhovov/following{/other_user}","gists_url":"https://api.github.com/users/mekhovov/gists{/gist_id}","starred_url":"https://api.github.com/users/mekhovov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mekhovov/subscriptions","organizations_url":"https://api.github.com/users/mekhovov/orgs","repos_url":"https://api.github.com/users/mekhovov/repos","ev