+class MetadataBudget:
+    """Fail closed on capacity, overlong records, short writes or storage errors."""
+    def __init__(self):
+        self.used = 0
+        self.lock = threading.Lock()
+
+    def reserve(self, raw, maximum):
+        if len(raw) > maximum:
+            raise ValueError('Audit metadata item exceeds its reviewed bound')
+        with self.lock:
+            if self.used + len(raw) > MAX_PERSISTED_METADATA_BYTES:
+                raise ValueError('Audit metadata exceeds its total persisted budget')
+            self.used += len(raw)
+
+    def file(self, target, raw, maximum):
+        self.reserve(raw, maximum)
+        with target.open('xb') as stream:
+            if stream.write(raw) != len(raw):
+                raise OSError('Incomplete audit metadata write')
+            stream.flush()
+
+    def line(self, stream, value):
+        text = json.dumps(value) + '\n'
+        self.reserve(text.encode('utf-8'), MAX_LOG_LINE_BYTES)
+        if stream.write(text) != len(text):
+            raise OSError('Incomplete audit log write')
+        stream.flush()
+
+
