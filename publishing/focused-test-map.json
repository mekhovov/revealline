{
  "format": "revealline-focused-test-map.v1",
  "categories": [
    {
      "id": "official-download-retention",
      "pathPatterns": [
        "^game/official-downloads\\.mjs$",
        "^game/test/official-downloads\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "official-download-retention",
          "command": "node",
          "args": [
            "--test",
            "game/test/official-downloads.test.mjs",
            "game/test/offline-download-access.test.mjs",
            "game/test/offline-team-retention-host.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "optional-offline-play",
      "pathPatterns": [
        "^game/offline-download-access\\.mjs$",
        "^game/offline/service-worker\\.template\\.js$",
        "^game/ui/company-startup\\.mjs$",
        "^game/test/optional-offline-access\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "optional-offline-play",
          "command": "node",
          "args": [
            "--test",
            "game/test/optional-offline-access.test.mjs",
            "game/test/company-startup.test.mjs",
            "game/test/published-solo-entry-host.test.mjs",
            "game/test/offline-team-retention-host.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "content-artwork-preparation",
      "pathPatterns": [
        "^game/content-design/(assets|attempt|limits|picture)\\.mjs$",
        "^game/test/(content-assets|content-attempt|content-picture|candidate-team-pictures)\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "content-artwork-preparation",
          "command": "node",
          "args": [
            "--test",
            "game/test/content-assets.test.mjs",
            "game/test/content-attempt.test.mjs",
            "game/test/content-picture.test.mjs",
            "game/test/candidate-team-pictures.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "neutral-pilot-evidence",
      "pathPatterns": [
        "^game/content-design/(neutral-pilot-session|uniqueness-pilot(-player)?)\\.mjs$",
        "^game/test/(neutral-pilot-session|uniqueness-pilot)\\.test\\.mjs$",
        "^scripts/verify-pilot-observations\\.mjs$",
        "^docs/content-offline/pilot-player\\.html$"
      ],
      "commands": [
        {
          "id": "neutral-pilot-evidence",
          "command": "node",
          "args": [
            "--test",
            "game/test/neutral-pilot-session.test.mjs",
            "game/test/uniqueness-pilot.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "content-inventory",
      "pathPatterns": [
        "^scripts/(content-inventory|content-artwork-screening|artwork-screening)\\.mjs$",
        "^game/content-design/content-lifecycle\\.mjs$",
        "^game/test/(content-lifecycle|artwork-screening)\\.test\\.mjs$",
        "^scripts/(test-)?company-artwork-screening\\.mjs$"
      ],
      "commands": [
        {
          "id": "content-inventory",
          "command": "node",
          "args": [
            "--test",
            "game/test/content-lifecycle.test.mjs",
            "game/test/artwork-screening.test.mjs",
            "scripts/test-company-artwork-screening.mjs"
          ]
        }
      ]
    },
    {
      "id": "company-content-inventory",
      "pathPatterns": ["^scripts/(test-)?company-content-inventory\\.mjs$"],
      "commands": [
        {
          "id": "company-content-inventory",
          "command": "node",
          "args": [
            "--test",
            "scripts/test-company-content-inventory.mjs",
            "game/test/edition-retained-presentation.test.mjs",
            "game/test/edition-profile-compatibility.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "offline-package-measurements",
      "pathPatterns": [
        "^scripts/(report-(published-)?offline-packages|test-report-(published-)?offline-packages)\\.mjs$"
      ],
      "commands": [
        {
          "id": "offline-package-measurements",
          "command": "node",
          "args": [
            "--test",
            "scripts/test-report-offline-packages.mjs",
            "scripts/test-report-published-offline-packages.mjs"
          ]
        }
      ]
    },
    {
      "id": "team-picture-bindings",
      "pathPatterns": [
        "^game/couch/coop-(picture-bindings|presentation)\\.mjs$",
        "^game/test/coop-(historical-import-picture|picture-bindings|reviewed-successor-picture)\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "team-picture-bindings",
          "command": "node",
          "args": [
            "--test",
            "game/test/coop-historical-import-picture.test.mjs",
            "game/test/coop-picture-bindings.test.mjs",
            "game/test/coop-reviewed-successor-picture.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "localization",
      "pathPatterns": [
        "(^|/)(locales?|localization|i18n)(/|[-.])",
        "^game/about/",
        "^game/couch/(?!coop-(?:picture-bindings|presentation)\\.mjs$)",
        "^scripts/localization(-main)?\\.mjs$"
      ],
      "commands": [
        {
          "id": "i18n-check",
          "command": "npm",
          "args": ["run", "i18n:check"]
        },
        {
          "id": "localization-runtime",
          "command": "node",
          "args": [
            "--test",
            "game/test/localization.test.mjs",
            "game/test/localization-couch-host.test.mjs",
            "game/test/localization-gameplay-copy.test.mjs",
            "game/test/localization-team-copy.test.mjs",
            "game/test/about-navigation-host.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "offline",
      "pathPatterns": ["offline", "service-worker", "manifest\\.webmanifest", "optional-chapters"],
      "commands": [
        {
          "id": "offline-runtime",
          "command": "node",
          "args": [
            "--test",
            "game/test/offline.test.mjs",
            "game/test/offline-panel.test.mjs",
            "game/test/optional-chapters-offline-host.test.mjs",
            "game/test/asset-studio-offline-fixtures.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "player-navigation-team",
      "pathPatterns": [
        "^game/(?:team|navigation)/",
        "^game/couch/(?!coop-(?:picture-bindings|presentation)\\.mjs$)",
        "^game/test/.*(couch|team|navigation|pause|result).*\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "player-navigation-team",
          "command": "node",
          "args": [
            "--test",
            "game/test/couch-navigation.test.mjs",
            "game/test/couch-composite-menu-navigation.test.mjs",
            "game/test/content-team-navigation.test.mjs",
            "game/test/controller-navigation.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "soundtrack-preferences-playback",
      "pathPatterns": [
        "^game/(managed-media-store|media-storage-record|soundtrack(?:-store|-style-selection|-style-taxonomy)?|online-soundtrack-catalogue|opening-soundtrack)\\.mjs$",
        "^game/ui/(soundtrack-player|soundtrack-panel|audio-master|quick-music-controls)\\.mjs$",
        "^game/couch/couch-music-(host|library|session)\\.mjs$",
        "^game/test/(soundtrack-(saved-styles|player|host|panel|style-selection|style-taxonomy)|managed-media-store|couch-music-(library|session)|opening-soundtrack)\\.test\\.mjs$",
        "^game/test/(soundtrack-store|managed-media-connection|online-soundtrack-catalogue|audio-master|quick-music-controls|couch-audio-master)\\.test\\.mjs$",
        "^game/test/helpers/(soundtrack-(public-catalogue|audio|fixtures)|managed-idb)\\.mjs$",
        "^game/test/fixtures/managed-media-store-pr779\\.mjs\\.txt$"
      ],
      "commands": [
        {
          "id": "soundtrack-preferences-playback",
          "command": "node",
          "args": [
            "--test",
            "--test-concurrency=1",
            "game/test/soundtrack-saved-styles.test.mjs",
            "game/test/soundtrack-player.test.mjs",
            "game/test/soundtrack-host.test.mjs",
            "game/test/soundtrack-panel.test.mjs",
            "game/test/soundtrack-style-selection.test.mjs",
            "game/test/soundtrack-style-taxonomy.test.mjs",
            "game/test/managed-media-store.test.mjs",
            "game/test/couch-music-library.test.mjs",
            "game/test/couch-music-session.test.mjs",
            "game/test/opening-soundtrack.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "publishing",
      "pathPatterns": [
        "^publishing/",
        "^scripts/(build-pages|pages-archive|pages-current-entry)\\.mjs$",
        "^\\.github/workflows/"
      ],
      "commands": [
        {
          "id": "publishing-controller",
          "command": "node",
          "args": [
            "--test",
            "publishing/focused-tests.test.mjs",
            "publishing/fastline-merge-controller.test.mjs",
            "publishing/fastline-release-inputs.test.mjs",
            "publishing/fastline-release-objects.test.mjs",
            "publishing/fastline-release-publisher.test.mjs",
            "publishing/test-policy.test.mjs",
            "publishing/pages-controller/archive-authority.test.mjs",
            "publishing/pages-controller/assemble.test.mjs",
            "publishing/pages-controller/metadata.test.mjs",
            "publishing/pages-controller/public-byte-audit.test.mjs",
            "publishing/pages-controller/release-asset.test.mjs",
            "publishing/pages-controller/release-policy.test.mjs",
            "publishing/pages-controller/release-train-boundary.test.mjs",
            "publishing/pages-controller/workflow.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "company-editions",
      "pathPatterns": [
        "^game/(runtime-(?:content-provider|library-sources)\\.mjs$|editions/|company-campaigns/|company(?:[.-])|edition-context\\.mjs$|installed-app\\.mjs$|profile-channel(?:-reader)?\\.mjs$|profile-transfer\\.mjs$|journey/profile\\.mjs$)",
        "^game/(test/company-.*\\.test\\.mjs|test/edition.*\\.test\\.mjs|presentation/player-projection\\.mjs)$",
        "^game/(controller-lab/|replay-theater/|app\\.mjs$|index\\.html$|test/runtime-content-provider\\.test\\.mjs$)",
        "^game/ui/(edition-(?:solo|lessons|play-layout|tool-provider|navigation|controller-practice)\\.mjs|edition-(?:solo|play)\\.css|profile-recovery-dialog\\.mjs|journey-collection\\.mjs)$",
        "^game/(profile-writer|external-chapter-(?:pointer|backup)|external-recovery-catalog|external-backup-assets|replay-(?:presentation|actor-context)|presentation/actor-appearance-(?:pin|lease))\\.mjs$",
        "^scripts/(compile-edition|bundle-editions|publish-editions|check-edition-source|edition-offline|offline-launcher|edition-localization|edition-runtime|edition-provider-parity|company-studio|produce-company-content|test-edition-offline|test-offline-publication|test-bundle-editions|test-company-review)\\.mjs$",
        "^docs/verification/company-review(?:\\.html|\\.mjs|-model\\.mjs)$",
        "^publishing/edition-.*\\.mjs$",
        "^authoring/company-studio/",
        "^game/content/company-(boot|campaigns)/",
        "^game/ui/(body-motion|body-backing|actor-recipes)\\.mjs$",
        "^game/(boot\\.mjs|ui/(company-startup|install-offline-panel)\\.mjs)$",
        "^scripts/(company-offline-packages|offline-content)\\.mjs$"
      ],
      "commands": [
        {
          "id": "company-generated-source-and-media",
          "command": "npm",
          "args": ["run", "company:check"]
        },
        {
          "id": "company-runtime-and-publication",
          "command": "npm",
          "args": ["run", "company:test"]
        },
        {
          "id": "company-review-measurements",
          "command": "node",
          "args": ["--test", "scripts/test-company-review.mjs"]
        },
        {
          "id": "edition-appearance-contracts",
          "command": "node",
          "args": [
            "--test",
            "game/test/actor-appearance-pin.test.mjs",
            "game/test/actor-appearance-lease.test.mjs",
            "game/test/replay-presentation.test.mjs",
            "game/test/replay-actor-context.test.mjs"
          ]
        },
        {
          "id": "edition-persistence-compatibility",
          "command": "node",
          "args": [
            "--test",
            "game/test/installed-app.test.mjs",
            "game/test/profile-transfer.test.mjs",
            "game/test/profile-channel-reader.test.mjs",
            "scripts/test-offline-publication.mjs"
          ]
        }
      ]
    },
    {
      "id": "company-offline-startup",
      "pathPatterns": [
        "^game/(boot\\.mjs|ui/(company-startup|install-offline-panel)\\.mjs)$",
        "^scripts/(company-offline-packages|offline-content)\\.mjs$",
        "^game/editions/offline-package-id\\.mjs$"
      ],
      "commands": [
        {
          "id": "company-offline-startup",
          "command": "node",
          "args": [
            "--test",
            "game/test/boot.test.mjs",
            "game/test/offline-download-access.test.mjs",
            "game/test/official-downloads.test.mjs",
            "game/test/install-offline-panel.test.mjs",
            "scripts/test-offline-core-closure.mjs"
          ]
        }
      ]
    },
    {
      "id": "offline-final-bytes",
      "pathPatterns": [
        "^scripts/(game-cli|offline-finalize|test-offline-finalize)\\.mjs$",
        "^publishing/(frozen-offline\\.test\\.mjs|utility/(verify_frozen_offline|test_verify_frozen_offline)\\.py)$"
      ],
      "commands": [
        {
          "id": "offline-final-bytes",
          "command": "node",
          "args": [
            "--test",
            "scripts/test-offline-finalize.mjs",
            "publishing/frozen-offline.test.mjs"
          ]
        }
      ]
    },
    {
      "id": "journey-star-compatibility",
      "pathPatterns": [
        "^game/journey/(profile|stars)\\.mjs$",
        "^game/mission-library/(journey-source|creator-source)\\.mjs$",
        "^game/test/journey-stars\\.test\\.mjs$"
      ],
      "commands": [
        {
          "id": "journey-star-compatibility",
          "command": "node",
          "args": [
            "--test",
            "game/test/journey-stars.test.mjs",
            "game/test/journey-backup.test.mjs",
            "game/test/journey-pictures.test.mjs",
            "game/test/journey-profile-editions.test.mjs",
            "game/test/journey.test.mjs",
            "game/test/creator-bundle.test.mjs"
          ]
        }
      ]
    }
  ],
  "ignoredPathPatterns": ["^(docs/|.*\\.md$)", "^publishing/pages-controller/(evidence|metadata)/"],
  "runtimePathPatterns": [
    "^(game|scripts|site|platforms|publishing)/",
    "^(package(-lock)?\\.json|eslint\\.config\\.mjs)$"
  ],
  "fallbackCommands": [
    {
      "id": "unknown-runtime-validate",
      "command": "npm",
      "args": ["run", "validate"]
    }
  ]
}
