# Copy to an untracked file outside source control, replace every placeholder, and pass it with
# docker compose --env-file. Keep the database password URL-encoded in COMMUNITY_DATABASE_URL.
COMMUNITY_POSTGRES_PASSWORD=replace-with-a-random-database-password
COMMUNITY_DATABASE_URL=postgres://revealline:replace-with-url-encoded-password@postgres:5432/revealline
COMMUNITY_RELEASE_VERSION=replace-with-v-prefixed-release-version
COMMUNITY_SOURCE_REVISION=replace-with-lowercase-40-character-source-revision

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://community.example.test
BETTER_AUTH_TRUSTED_ORIGINS=https://game.example.test
COMMUNITY_ACCOUNT_MAIL_WEBHOOK_URL=https://mail-gateway.example.test/revealline/account
COMMUNITY_ACCOUNT_MAIL_WEBHOOK_TOKEN=replace-with-a-separate-at-least-32-character-secret
COMMUNITY_ADMIN_SUBJECTS=replace-with-better-auth-user-id

# Set the exact number of reverse proxies between clients and the API. Use 1 for one trusted edge.
COMMUNITY_TRUST_PROXY_HOPS=1

# PostgreSQL-backed admission limits shared across API replicas.
COMMUNITY_AUTH_ATTEMPTS_PER_WINDOW=30
COMMUNITY_AUTH_WINDOW_SECONDS=300
COMMUNITY_REPORTS_PER_WINDOW=6
COMMUNITY_REPORT_WINDOW_SECONDS=3600
COMMUNITY_SUBMISSIONS_PER_WINDOW=12
COMMUNITY_SUBMISSION_WINDOW_SECONDS=3600
COMMUNITY_UPLOAD_BYTES_PER_WINDOW=2147483648
COMMUNITY_UPLOAD_WINDOW_SECONDS=86400

COMMUNITY_TUS_EXPIRATION_SECONDS=86400
COMMUNITY_TUS_CLEANUP_INTERVAL_SECONDS=300
COMMUNITY_TUS_CLEANUP_BATCH_SIZE=32
COMMUNITY_TUS_CLEANUP_LEASE_SECONDS=120
COMMUNITY_TUS_LOCK_TIMEOUT_SECONDS=30
COMMUNITY_TUS_LOCK_POOL_SIZE=20
COMMUNITY_MAX_PACKAGE_BYTES=268435456
COMMUNITY_VALIDATOR_VERSION=creator-bundle-v1
COMMUNITY_WORKER_POLL_MS=1000
COMMUNITY_EMAIL_VERIFICATION_EXPIRES_SECONDS=3600
COMMUNITY_PASSWORD_RESET_EXPIRES_SECONDS=1800
COMMUNITY_ACCOUNT_MAIL_TIMEOUT_MS=5000
