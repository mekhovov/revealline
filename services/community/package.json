{
  "name": "@revealline/community-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted RevealLine community submission and catalog service scaffold",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "worker": "node src/worker-runner.mjs",
    "auth:migrate": "node src/auth-migrate.mjs",
    "deployment:preflight": "node src/deployment-preflight-runner.mjs",
    "recovery": "node src/recovery-runner.mjs",
    "recovery:rehearse": "node src/recovery-rehearsal-runner.mjs",
    "acceptance:tus-resume": "node scripts/tus-resume-acceptance.mjs",
    "acceptance:tus-deployed": "node src/deployed-tus-resume-runner.mjs",
    "acceptance:deployed": "node src/deployed-journey-runner.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" eslint.config.mjs --max-warnings 0",
    "format": "prettier --write \"**/*.{mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{mjs,json,md,yaml,yml}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@tus/file-store": "2.1.1",
    "@tus/s3-store": "2.0.7",
    "@tus/server": "2.4.5",
    "better-auth": "1.7.6",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "1.7.6",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.6.2"
  }
}
