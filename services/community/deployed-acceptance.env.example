# Copy to an untracked owner-only file and replace every placeholder. Both deployed acceptance
# runners can sign in already verified Better Auth accounts without persisting their session
# cookies. The full journey needs two distinct creators and one configured administrator.
COMMUNITY_ACCEPTANCE_BASE_URL=https://community.example.test/
COMMUNITY_ACCEPTANCE_NAMESPACE=journey-deploy-unique-run
COMMUNITY_ACCEPTANCE_ALLOW_DESTRUCTIVE=I_UNDERSTAND_THIS_PUBLISHES_AND_UNLISTS_TEST_CONTENT
COMMUNITY_ACCEPTANCE_EXPECTED_VERSION=replace-with-v-prefixed-release-version
COMMUNITY_ACCEPTANCE_EXPECTED_SOURCE_REVISION=replace-with-lowercase-40-character-source-revision
COMMUNITY_ACCEPTANCE_CREATOR_A_EMAIL=verified-creator-a@example.test
COMMUNITY_ACCEPTANCE_CREATOR_A_PASSWORD=replace-with-short-lived-creator-a-password
COMMUNITY_ACCEPTANCE_CREATOR_B_EMAIL=verified-creator-b@example.test
COMMUNITY_ACCEPTANCE_CREATOR_B_PASSWORD=replace-with-short-lived-creator-b-password
COMMUNITY_ACCEPTANCE_ADMIN_EMAIL=verified-admin@example.test
COMMUNITY_ACCEPTANCE_ADMIN_PASSWORD=replace-with-short-lived-admin-password
COMMUNITY_ACCEPTANCE_RECEIPT=/secure/path/community-deployed-acceptance.json

# The tus journey publishes another disposable valid campaign, interrupts the first PATCH after 17
# committed bytes, resumes the same resource, verifies publication/download, and unlists it.
COMMUNITY_TUS_ACCEPTANCE_BASE_URL=https://community.example.test/
COMMUNITY_TUS_ACCEPTANCE_NAMESPACE=tus-deploy-unique-run
COMMUNITY_TUS_ACCEPTANCE_ALLOW_DESTRUCTIVE=I_UNDERSTAND_THIS_PUBLISHES_AND_UNLISTS_TEST_CONTENT
COMMUNITY_TUS_ACCEPTANCE_EXPECTED_VERSION=replace-with-v-prefixed-release-version
COMMUNITY_TUS_ACCEPTANCE_EXPECTED_SOURCE_REVISION=replace-with-lowercase-40-character-source-revision
COMMUNITY_TUS_ACCEPTANCE_EXPECTED_VALIDATOR_VERSION=creator-bundle-v1

# Choose exactly one credential form for each actor. Verified email/password accounts are the
# automated production path; cookies and development bearer tokens remain supported alternatives.
COMMUNITY_TUS_ACCEPTANCE_CREATOR_EMAIL=verified-creator-a@example.test
COMMUNITY_TUS_ACCEPTANCE_CREATOR_PASSWORD=replace-with-short-lived-creator-a-password
COMMUNITY_TUS_ACCEPTANCE_ADMIN_EMAIL=verified-admin@example.test
COMMUNITY_TUS_ACCEPTANCE_ADMIN_PASSWORD=replace-with-short-lived-admin-password
# COMMUNITY_TUS_ACCEPTANCE_CREATOR_COOKIE=better-auth.session_token=replace-with-short-lived-creator-session
# COMMUNITY_TUS_ACCEPTANCE_ADMIN_COOKIE=better-auth.session_token=replace-with-short-lived-admin-session
# COMMUNITY_TUS_ACCEPTANCE_CREATOR_AUTHORIZATION=Bearer replace-with-short-lived-creator-token
# COMMUNITY_TUS_ACCEPTANCE_ADMIN_AUTHORIZATION=Bearer replace-with-short-lived-admin-token

COMMUNITY_TUS_ACCEPTANCE_RECEIPT=/secure/path/community-deployed-tus-acceptance.json
COMMUNITY_TUS_ACCEPTANCE_DROP_AFTER_BYTES=17
COMMUNITY_TUS_ACCEPTANCE_CHUNK_BYTES=1048576
COMMUNITY_TUS_ACCEPTANCE_REQUEST_TIMEOUT_MS=15000
COMMUNITY_TUS_ACCEPTANCE_POLL_INTERVAL_MS=1000
COMMUNITY_TUS_ACCEPTANCE_VALIDATION_TIMEOUT_MS=120000
