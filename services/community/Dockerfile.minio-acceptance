FROM golang:1.24.2-alpine3.22 AS build

RUN apk add --no-cache git
WORKDIR /src

# MinIO removed its public prebuilt community images in 2026. Build the last
# signed archived release from its exact official commit for this acceptance
# fixture instead of depending on an unaffiliated binary mirror.
RUN git init \
  && git remote add origin https://github.com/minio/minio.git \
  && git fetch --depth 1 origin 07c3a429bfed433e49018cb0f78a52145d4bedeb \
  && git checkout --detach FETCH_HEAD \
  && test "$(git rev-parse HEAD)" = 07c3a429bfed433e49018cb0f78a52145d4bedeb
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/minio .

FROM alpine:3.22

RUN apk add --no-cache ca-certificates curl
COPY --from=build /out/minio /usr/local/bin/minio

EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
