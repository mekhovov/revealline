{
  "name": "revealline-ios-scaffold",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Local Capacitor iOS wrapper for the unchanged Reveal Line web distribution",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test test/*.test.mjs",
    "bridge:build": "node scripts/build-bridge.mjs",
    "native:add": "cap add ios --packagemanager SPM",
    "native:copy": "cap copy ios",
    "native:sync": "cap sync ios",
    "native:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  }
}
